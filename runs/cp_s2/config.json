{
  "env": "cartpole",
  "seed": 2,
  "episodes": 600,
  "gamma": 0.95,
  "lr": 0.0005,
  "lr_final_frac": 1.0,
  "lr_decay_updates": 0,
  "batch_size": 64,
  "buffer_size": 50000,
  "learn_start": 1000,
  "train_freq": 1,
  "target_update": 0,
  "tau": 0.005,
  "eps_start": 1.0,
  "eps_end": 0.02,
  "eps_decay_steps": 5000,
  "double": false,
  "huber": true,
  "grad_clip": 10.0,
  "reward_clip": false,
  "eval_every": 10,
  "eval_episodes": 10,
  "eval_eps": 0.0,
  "final_rollouts": 500,
  "final_ckpt": "best",
  "age_every": 200,
  "snapshot_count": 8,
  "out": "runs/cp_s2",
  "device": "cpu"
}